{
  "name": "workdesk-api",
  "version": "0.3.0",
  "private": true,
  "description": "WorkDesk helpdesk and service request API (Next.js route handlers, Prisma, PostgreSQL)",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "typecheck": "tsc --noEmit",
    "test:e2e": "vitest run --config vitest.config.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "~6.19.3",
    "argon2": "^0.45.2",
    "jose": "^6.1.0",
    "next": "^15.5.9",
    "nodemailer": "^7.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.6.1",
    "prisma": "~6.19.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
