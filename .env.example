#  Never commit .env.

# --- App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

CORS_ORIGINS=http://localhost:3000

# --- Database 
POSTGRES_USER=workdesk
POSTGRES_PASSWORD=workdesk_dev_password
POSTGRES_DB=workdesk
POSTGRES_PORT=5432

DATABASE_URL=postgresql://workdesk:workdesk_dev_password@localhost:5432/workdesk?schema=public

# --- Auth

JWT_ACCESS_SECRET=change-me-generate-a-48-byte-random-hex-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
SESSION_MAX_DAYS=30
# Set true when served over HTTPS (required in production)
COOKIE_SECURE=false


UPLOAD_DIR=./storage/uploads

SEED_ADMIN_EMAIL
SEED_ADMIN_PASSWORD