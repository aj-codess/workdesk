// =============================================================================
// WorkDesk — Prisma schema (single tenant, PostgreSQL)
// Conventions
//   - UUID primary keys generated by Postgres (gen_random_uuid(), PG13+)
//   - snake_case tables/columns in the DB, camelCase in code (@map / @@map)
//   - timestamptz everywhere
//   - Soft delete (deletedAt) only where history must survive: users, tickets, comments
//   - Things Prisma cannot express (partial unique indexes, CHECKs, triggers) live in
//     a hand-written migration: see architecture.md section 8
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE // deactivated by an admin: cannot log in, sessions revoked
  // Brute-force lockout is deliberately NOT a status. It is time-based (users.locked_until)
  // so it expires on its own and never needs a manual unlock.
}

enum TicketStatus {
  PENDING_REVIEW          // submitted, waiting in the department queue
  CLARIFICATION_REQUESTED // manager needs more info from the requester
  ACCEPTED                // department agreed to handle it, not yet assigned
  REJECTED                // terminal, rejectionReason required
  ASSIGNED                // an agent owns it
  IN_PROGRESS             // agent is working on it
  RESOLVED                // work done, resolution recorded
  CLOSED                  // formally closed
  REOPENED                // resolved/closed ticket sent back for more work
  CANCELLED               // withdrawn by the requester before it was resolved
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CommentKind {
  COMMENT        // visible to requester and staff
  WORK_NOTE      // internal, never returned to a requester-only viewer
  CLARIFICATION  // manager question or requester answer inside a clarification loop
}

enum ActivityAction {
  SUBMITTED
  UPDATED
  CLARIFICATION_REQUESTED
  CLARIFICATION_PROVIDED
  ACCEPTED
  REJECTED
  ASSIGNED
  REASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  DEPARTMENT_TRANSFERRED
  COMMENTED
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
  DELETED
}

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  USER_DEACTIVATED
  PASSWORD_CHANGED
  PASSWORD_RESET
  REFRESH_REUSE_DETECTED // a rotated refresh token was replayed: whole session killed
  ADMIN_REVOKED
}

enum AuditOutcome {
  SUCCESS
  DENIED  // blocked by authorization
  FAILURE // error
}

// -----------------------------------------------------------------------------
// ORGANIZATION
// -----------------------------------------------------------------------------

model Department {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(120)
  code        String   @unique @db.VarChar(20) // short code, e.g. IT, HR, FIN
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // People whose HOME department this is (informational, never restricts requests)
  homeUsers User[] @relation("UserHomeDepartment")

  // Queue governance
  managers DepartmentManager[]
  members  DepartmentMember[]

  // Catalogue and workload
  categories           TicketCategory[]
  ticketsReceived      Ticket[] @relation("TicketDestination")
  ticketsFromDepartment Ticket[] @relation("TicketRequesterDepartment")

  @@map("departments")
}

// Scope table: who may review the queue of a department. A user also needs the
// relevant tickets.* permissions through a role. 1 to N managers (cap set in
// application_settings, default 3, enforced in the service layer).
model DepartmentManager {
  departmentId String   @map("department_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User        @relation("ManagerUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?       @relation("ManagerAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([departmentId, userId])
  @@index([userId])
  @@map("department_managers")
}

// Support agent of a department: the agents a manager may assign tickets to.
model DepartmentMember {
  departmentId String   @map("department_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  addedById    String?  @map("added_by_id") @db.Uuid
  addedAt      DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User        @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy    User?       @relation("MemberAdder", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([departmentId, userId])
  @@index([userId])
  @@map("department_members")
}

// -----------------------------------------------------------------------------
// IDENTITY AND AUTHORIZATION (RBAC)
// -----------------------------------------------------------------------------

model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String     @unique @db.VarChar(255) // stored lowercase (CHECK in raw migration)
  passwordHash       String     @map("password_hash")    // argon2id, never returned by any API
  firstName          String     @map("first_name") @db.VarChar(100)
  lastName           String     @map("last_name") @db.VarChar(100)
  phone              String?    @db.VarChar(30)
  jobTitle           String?    @map("job_title") @db.VarChar(120)
  avatarUrl          String?    @map("avatar_url")
  status             UserStatus @default(INACTIVE)
  departmentId       String?    @map("department_id") @db.Uuid // home department, nullable (open decision)
  mustChangePassword Boolean    @default(false) @map("must_change_password")

  // Brute-force protection
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6) // login refused while in the future
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)

  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  homeDepartment Department? @relation("UserHomeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  // Authorization
  userRoles          UserRole[]       @relation("UserRoleUser")
  rolesAssigned      UserRole[]       @relation("UserRoleAssigner")
  permissionsGranted RolePermission[] @relation("RolePermissionGrantor")

  // Department scope
  managedDepartments  DepartmentManager[] @relation("ManagerUser")
  managerAssignments  DepartmentManager[] @relation("ManagerAssigner")
  memberships         DepartmentMember[]  @relation("MemberUser")
  membershipsAdded    DepartmentMember[]  @relation("MemberAdder")

  // Auth and sessions
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  // Tickets
  ticketsRequested   Ticket[]           @relation("TicketRequester")
  ticketsAssigned    Ticket[]           @relation("TicketAssignee")
  ticketsReviewed    Ticket[]           @relation("TicketReviewer")
  ticketsResolved    Ticket[]           @relation("TicketResolver")
  assignmentsAsAgent TicketAssignment[] @relation("AssignmentAgent")
  assignmentsMade    TicketAssignment[] @relation("AssignmentAssigner")
  comments           TicketComment[]
  activities         TicketActivity[]
  attachments        TicketAttachment[]

  // Governance
  auditLogs        AuditLog[]
  settingsUpdated  ApplicationSetting[]

  @@index([status])
  @@index([departmentId])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(80)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  // Seeded roles (System Administrator, Support Manager, ...) are flagged so they
  // cannot be deleted. They stay editable except for the System Administrator
  // safeguards (see architecture.md section 5.6). Nothing in code branches on role NAME.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

// The permission catalogue is SEEDED, not user-created. Admins only decide which
// permissions belong to which role.
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(100) // e.g. tickets.assign
  module      String   @db.VarChar(50)          // users, roles, tickets, ... for grouped UI
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user       User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("UserRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedById  String?  @map("granted_by_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("RolePermissionGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// SESSIONS AND CREDENTIAL TOKENS
// One Session per login (device/browser). Each refresh creates a NEW RefreshToken
// row and marks the previous one as used. Only SHA-256 hashes are stored.
// -----------------------------------------------------------------------------

model Session {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // = "sid" claim in the access token
  userId        String               @map("user_id") @db.Uuid
  userAgent     String?              @map("user_agent")
  ipAddress     String?              @map("ip_address") @db.VarChar(45)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt    DateTime             @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt     DateTime             @map("expires_at") @db.Timestamptz(6) // absolute lifetime, not extended by rotation
  revokedAt     DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokedReason SessionRevokeReason? @map("revoked_reason")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64) // hex SHA-256 of a 256-bit random value
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)    // set when rotated; presenting it again = theft signal
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?  @unique @map("replaced_by_id") @db.Uuid // forward link in the rotation chain

  session    Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenChain", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenChain")

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6) // short: 15 to 30 minutes
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  requestedIp String?   @map("requested_ip") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Raw attempt log used with the throttler and the per-user lockout. userId is NOT a
// foreign key on purpose: attempts against unknown emails must be recorded too.
model LoginAttempt {
  id            BigInt   @id @default(autoincrement())
  email         String   @db.VarChar(255)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  success       Boolean
  failureReason String?  @map("failure_reason") @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

// -----------------------------------------------------------------------------
// SERVICE REQUESTS
// -----------------------------------------------------------------------------

// Categories belong to the department that handles them (e.g. "Laptop request" -> IT).
model TicketCategory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  name         String   @db.VarChar(120)
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  // Hook for the "approval is not acceptance" rule: sensitive categories (payroll,
  // personal data) get stricter visibility and an extra approval step later.
  isSensitive  Boolean  @default(false) @map("is_sensitive")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  tickets    Ticket[]

  @@unique([departmentId, name])
  @@map("ticket_categories")
}

model Ticket {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Human reference. Displayed as WD-<year>-<zero padded number>; derive in the view
  // layer so the DB stays the single source of truth for the sequence.
  number Int    @unique @default(autoincrement())

  title       String         @db.VarChar(200)
  description String
  categoryId  String         @map("category_id") @db.Uuid
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(PENDING_REVIEW)

  // People
  requesterId        String  @map("requester_id") @db.Uuid
  // Snapshot at submission time: the requester's department and roles can change
  // later, but reviewers need to see who asked and from where AT THE TIME.
  requesterDepartmentId String? @map("requester_department_id") @db.Uuid
  requesterSnapshot     Json?   @map("requester_snapshot") // { name, email, department, roles[] }

  // Routing
  departmentId     String  @map("department_id") @db.Uuid // destination queue (one at a time)
  assignedAgentId  String? @map("assigned_agent_id") @db.Uuid // current assignee; history in ticket_assignments

  // Departmental review
  reviewedById    String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?   @map("rejection_reason")

  // Resolution and closure
  resolution   String?
  resolvedById String?   @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt     DateTime? @map("closed_at") @db.Timestamptz(6)
  reopenCount  Int       @default(0) @map("reopen_count")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  category            TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  requester           User           @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  requesterDepartment Department?    @relation("TicketRequesterDepartment", fields: [requesterDepartmentId], references: [id], onDelete: SetNull)
  department          Department     @relation("TicketDestination", fields: [departmentId], references: [id], onDelete: Restrict)
  assignedAgent       User?          @relation("TicketAssignee", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  reviewedBy          User?          @relation("TicketReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  resolvedBy          User?          @relation("TicketResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  assignments TicketAssignment[]
  comments    TicketComment[]
  activities  TicketActivity[]
  attachments TicketAttachment[]

  // Index design follows the access paths: department queues, "my requests",
  // "my assignments", global filters, and the default list order.
  @@index([departmentId, status, createdAt(sort: Desc)])
  @@index([requesterId, createdAt(sort: Desc)])
  @@index([assignedAgentId, status])
  @@index([status, priority])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("tickets")
}

// Append-only assignment history. Exactly one row per ticket may be "current"
// (unassignedAt IS NULL): enforced by a partial unique index in the raw migration.
model TicketAssignment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId     String    @map("ticket_id") @db.Uuid
  agentId      String    @map("agent_id") @db.Uuid
  assignedById String    @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  unassignedAt DateTime? @map("unassigned_at") @db.Timestamptz(6)
  reason       String?   // mandatory on reassignment

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agent      User   @relation("AssignmentAgent", fields: [agentId], references: [id], onDelete: Restrict)
  assignedBy User   @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([ticketId, assignedAt])
  @@index([agentId])
  @@map("ticket_assignments")
}

model TicketComment {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId  String      @map("ticket_id") @db.Uuid
  authorId  String      @map("author_id") @db.Uuid
  kind      CommentKind @default(COMMENT)
  body      String
  editedAt  DateTime?   @map("edited_at") @db.Timestamptz(6)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime?   @map("deleted_at") @db.Timestamptz(6)

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

// Append-only business timeline of a ticket (what the requester and staff see).
// Distinct from audit_logs, which is the security/governance trail.
model TicketActivity {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId   String         @map("ticket_id") @db.Uuid
  actorId    String?        @map("actor_id") @db.Uuid
  action     ActivityAction
  fromStatus TicketStatus?  @map("from_status")
  toStatus   TicketStatus?  @map("to_status")
  metadata   Json?          // old/new values, reason, assignee, target department...
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_activity")
}

// Optional (PDF: "attachments, if supported"). Files live on disk/object storage;
// only metadata is stored here. Downloads must pass the same scope check as the ticket.
model TicketAttachment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  commentId    String?  @map("comment_id") @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(120)
  sizeBytes    Int      @map("size_bytes")
  storageKey   String   @unique @map("storage_key") // opaque, never derived from the user's file name
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment    TicketComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  uploadedBy User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("ticket_attachments")
}

// -----------------------------------------------------------------------------
// SYSTEM OPERATIONS
// -----------------------------------------------------------------------------

// Security and governance trail: logins, denied access, role/permission changes,
// user lifecycle, session revocations, ticket deletions. Append-only (trigger in
// the raw migration). actorId is nullable for system events and unknown-user attempts.
model AuditLog {
  id         BigInt       @id @default(autoincrement())
  actorId    String?      @map("actor_id") @db.Uuid
  action     String       @db.VarChar(100) // e.g. roles.permissions_updated, auth.login_failed
  entityType String?      @map("entity_type") @db.VarChar(50)
  entityId   String?      @map("entity_id") @db.VarChar(64)
  outcome    AuditOutcome @default(SUCCESS)
  before     Json?
  after      Json?
  ipAddress  String?      @map("ip_address") @db.VarChar(45)
  userAgent  String?      @map("user_agent")
  requestId  String?      @map("request_id") @db.VarChar(64)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

model ApplicationSetting {
  key         String   @id @db.VarChar(100) // e.g. department.max_managers, auth.access_ttl_seconds
  value       Json
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("application_settings")
}
